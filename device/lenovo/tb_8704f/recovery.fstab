# TB-8704F A-only, non-dynamic recovery fstab.
# Critical firmware/security/EFS partitions are intentionally not exposed.

/system         ext4  /dev/block/platform/soc/7824900.sdhci/by-name/system      flags=display="System";backup=1
/system_image   emmc  /dev/block/platform/soc/7824900.sdhci/by-name/system      flags=display="System Image";backup=1
/data           ext4  /dev/block/platform/soc/7824900.sdhci/by-name/userdata    flags=display="Data";backup=1;encryptable=footer;length=-16384
/cache          ext4  /dev/block/platform/soc/7824900.sdhci/by-name/cache       flags=display="Cache";backup=1;wipeingui
/persist        ext4  /dev/block/platform/soc/7824900.sdhci/by-name/persist     flags=display="Persist";backup=1
/lenovocust     ext4  /dev/block/platform/soc/7824900.sdhci/by-name/lenovocust  flags=display="Lenovo Custom";backup=1
/firmware       vfat  /dev/block/platform/soc/7824900.sdhci/by-name/modem      flags=mounttodecrypt;fsflags=ro
/boot           emmc  /dev/block/platform/soc/7824900.sdhci/by-name/boot        flags=display="Boot";backup=1
/recovery       emmc  /dev/block/platform/soc/7824900.sdhci/by-name/recovery    flags=display="Recovery";backup=1
/misc           emmc  /dev/block/platform/soc/7824900.sdhci/by-name/misc        flags=display="Misc"

/sdcard1        auto  /dev/block/mmcblk1p1                      flags=display="MicroSD";storage;wipeingui;removable
/usb-otg        auto  /dev/block/sda1                           flags=display="USB OTG";storage;wipeingui;removable
