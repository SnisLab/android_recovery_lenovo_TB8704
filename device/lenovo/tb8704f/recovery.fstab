# TB-8704F A-only, non-dynamic recovery fstab.
# Raw firmware/security/EFS entries are backup-only: no wipe flags are used.

/system         ext4  /dev/block/bootdevice/by-name/system      flags=display="System";backup=1
/system_image   emmc  /dev/block/bootdevice/by-name/system      flags=display="System Image";backup=1
/data           ext4  /dev/block/bootdevice/by-name/userdata    flags=display="Data";backup=1;encryptable=footer,length=-16384
/cache          ext4  /dev/block/bootdevice/by-name/cache       flags=display="Cache";backup=1;wipeingui
/persist        ext4  /dev/block/bootdevice/by-name/persist     flags=display="Persist";backup=1
/lenovocust     ext4  /dev/block/bootdevice/by-name/lenovocust  flags=display="Lenovo Custom";backup=1
/boot           emmc  /dev/block/bootdevice/by-name/boot        flags=display="Boot";backup=1
/recovery       emmc  /dev/block/bootdevice/by-name/recovery    flags=display="Recovery";backup=1
/misc           emmc  /dev/block/bootdevice/by-name/misc        flags=display="Misc"

/sdcard1        auto  /dev/block/mmcblk1p1                      flags=display="MicroSD";storage;wipeingui;removable
/usb-otg        auto  /dev/block/sda1                           flags=display="USB OTG";storage;wipeingui;removable

# Backup visibility only. These partitions must never be wiped, formatted, or
# written during recovery bring-up.
/dsp            emmc  /dev/block/bootdevice/by-name/dsp        flags=display="DSP";backup=1
/firmware       emmc  /dev/block/bootdevice/by-name/modem      flags=display="Firmware";backup=1
/efs1           emmc  /dev/block/bootdevice/by-name/modemst1   flags=display="EFS";backup=1
/efs2           emmc  /dev/block/bootdevice/by-name/modemst2   flags=backup=1;subpartitionof=/efs1
/efsg           emmc  /dev/block/bootdevice/by-name/fsg        flags=backup=1;subpartitionof=/efs1
/efsc           emmc  /dev/block/bootdevice/by-name/fsc        flags=backup=1;subpartitionof=/efs1
/aboot          emmc  /dev/block/bootdevice/by-name/aboot      flags=display="Bootloader";backup=1
/cmnlib         emmc  /dev/block/bootdevice/by-name/cmnlib     flags=backup=1;subpartitionof=/aboot
/cmnlib64       emmc  /dev/block/bootdevice/by-name/cmnlib64   flags=backup=1;subpartitionof=/aboot
/tz             emmc  /dev/block/bootdevice/by-name/tz         flags=backup=1;subpartitionof=/aboot
/rpm            emmc  /dev/block/bootdevice/by-name/rpm        flags=backup=1;subpartitionof=/aboot
/keymaster      emmc  /dev/block/bootdevice/by-name/keymaster  flags=backup=1;subpartitionof=/aboot
/devcfg         emmc  /dev/block/bootdevice/by-name/devcfg     flags=backup=1;subpartitionof=/aboot
